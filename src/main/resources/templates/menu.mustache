<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CafeLounge | Menu</title>

    <link rel="stylesheet" href="/css/output.css">
</head>

<body>


    <div class="drawer">
        <input id="my-drawer" type="checkbox" class="drawer-toggle" />
        <div class="drawer-content">
            <div class="flex">
                <div>
                    <div class="navbar bg-base-100">
                        <div class="flex-none">
                            <label for="my-drawer" class="btn btn-square btn-ghost">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                                    class="inline-block h-5 w-5 stroke-current">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                        d="M4 6h16M4 12h16M4 18h16">
                                    </path>
                                </svg>
                            </label>
                        </div>
                        <div class="flex-1">
                        </div>
                        <div class="flex-none">
                            <button class="btn btn-square btn-ghost">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                                    class="inline-block h-5 w-5 stroke-current">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                        d="M5 12h.01M12 12h.01M19 12h.01M6 12a1 1 0 11-2 0 1 1 0 012 0zm7 0a1 1 0 11-2 0 1 1 0 012 0zm7 0a1 1 0 11-2 0 1 1 0 012 0z">
                                    </path>
                                </svg>
                            </button>
                        </div>
                    </div>

                    <div class="mt-5 px-5 flex gap-5">
                        <div>
                            <!-- Menu categories -->
                            <div class="flex gap-5">
                                <div class="card shadow-sm">
                                    <div class="card-body p-3 flex-row items-center gap-3">
                                        All
                                        <small>110 items</small>
                                    </div>
                                </div>
                                {{#menuCategories}}
                                <div class="card shadow-sm">
                                    <div class="card-body p-3 flex-row items-center gap-3">
                                        {{.}}
                                        <small>110 items</small>
                                    </div>
                                </div>
                                {{/menuCategories}}
                            </div>


                            <!-- Search -->
                            <div class="mt-5">
                                <input type="text" class="input w-full" placeholder="Search">
                            </div>

                            <!-- Menu -->
                            <div class="grid grid-cols-4 mt-5 gap-5">
                                <div class="card">
                                    <div class="card-body p-3 shadow-sm">
                                        <img src="https://img.daisyui.com/images/stock/photo-1606107557195-0e29a4b5b4aa.webp"
                                            alt="">

                                        <p class="font-semibold">Beef Crowich</p>
                                        <div class="flex justify-between items-center">
                                            <span class="badge badge-soft badge-secondary">Sandwich</span>
                                            <span class="font-semibold">$5.50</span>
                                        </div>
                                    </div>
                                </div>

                                <div class="card">
                                    <div class="card-body p-3 shadow-sm">
                                        <img src="https://img.daisyui.com/images/stock/photo-1606107557195-0e29a4b5b4aa.webp"
                                            alt="">

                                        <p class="font-semibold">Beef Crowich</p>
                                        <div class="flex justify-between items-center">
                                            <span class="badge badge-soft badge-secondary">Sandwich</span>
                                            <span class="font-semibold">$5.50</span>
                                        </div>
                                    </div>
                                </div>

                                <div class="card">
                                    <div class="card-body p-3 shadow-sm">
                                        <img src="https://img.daisyui.com/images/stock/photo-1606107557195-0e29a4b5b4aa.webp"
                                            alt="">

                                        <p class="font-semibold">Beef Crowich</p>
                                        <div class="flex justify-between items-center">
                                            <span class="badge badge-soft badge-secondary">Sandwich</span>
                                            <span class="font-semibold">$5.50</span>
                                        </div>
                                    </div>
                                </div>

                                <div class="card">
                                    <div class="card-body p-3 shadow-sm">
                                        <img src="https://img.daisyui.com/images/stock/photo-1606107557195-0e29a4b5b4aa.webp"
                                            alt="">

                                        <p class="font-semibold">Beef Crowich</p>
                                        <div class="flex justify-between items-center">
                                            <span class="badge badge-soft badge-secondary">Sandwich</span>
                                            <span class="font-semibold">$5.50</span>
                                        </div>
                                    </div>
                                </div>

                                <div class="card">
                                    <div class="card-body p-3 shadow-sm">
                                        <img src="https://img.daisyui.com/images/stock/photo-1606107557195-0e29a4b5b4aa.webp"
                                            alt="">

                                        <p class="font-semibold">Beef Crowich</p>
                                        <div class="flex justify-between items-center">
                                            <span class="badge badge-soft badge-secondary">Sandwich</span>
                                            <span class="font-semibold">$5.50</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>


                <div class="min-w-sm h-screen shadow flex flex-col">
                    <div class="">
                        <div>

                        </div>
                        <div class="text-center py-2 border-b border-neutral-200">
                            <p class="">Customer's Name</p>
                            <small>Order Number: #000</small>
                        </div>
                        <div>

                        </div>
                    </div>

                    <div class="flex items-center gap-3 mt-3 px-3">
                        <select name="" id="" class="select select-bordered">
                            <option value="">Select Table</option>
                        </select>
                        <select name="" id="" class="select select-bordered">
                            <option value="">Order Type</option>
                        </select>
                    </div>

                    <!-- Order list -->
                    <div class="px-3 flex-1">
                        <div class="w-full border-b-2 p-6 text-center border-neutral-300 border-dashed">
                            <small class="text-neutral-500">
                                No item Selected
                            </small>
                        </div>
                    </div>


                    <div class="p-3 font-semibold flex justify-between">
                        <p class="">TOTAL</p>
                        <div class="flex items-center gap-10">
                            <span>$</span>
                            <span>0.00</span>
                        </div>
                    </div>

                    <div class="">
                        <button class="btn rounded-none btn-primary w-full" disabled="true">Place Order</button>
                    </div>
                </div>
            </div>
        </div>
        <div class="drawer-side">
            <label for="my-drawer" aria-label="close sidebar" class="drawer-overlay"></label>
            <div class="bg-base-200 text-base-content min-h-full w-80 flex flex-col justify-between">
                <div class="w-full">
                    <button class="btn btn-ghost w-full"></button>
                </div>
                <ul class="menu menu-lg w-full p-4 flex-1">
                    <li><a href="/menu">Point of Sales</a></li>
                    <li><a href="/activity">Activity</a></li>
                    <li><a href="/report">Report</a></li>
                    <li><a href="/inventory">Inventory</a></li>
                    <li><a href="/teams">Teams</a></li>
                </ul>
                <div>
                <form action="/logout" method="post">
                    <input type="hidden" name="_csrf" value="{{_csrf.token}}" />
                    <button class="btn btn-ghost w-full" type="submit">Logout</button>
                </form>
                </div>
            </div>
        </div>
    </div>

</body>

</html>