<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CafeLounge | Login</title>

    <link rel="stylesheet" href="/css/output.css">
</head>

<body>
    <div class="flex flex-col items-center justify-center h-screen w-full">
        <div class="min-w-xs ">
            <p class="text-2xl font-semibold">Sign In</p>
        </div>
        <br>
        <form action="/login" method="post" class="min-w-xs flex flex-col gap-3">

            <input type="hidden" name="_csrf" value="{{_csrf.token}}" />

            <fieldset class="fieldset">
                <legend class="fieldset-legend">Username</legend>
                <input type="text" name="username" class="input w-full" placeholder="" />
                <p class="label"></p>
            </fieldset>

            <fieldset class="fieldset">
                <legend class="fieldset-legend">Password</legend>
                <input type="password" name="password" class="input w-full" placeholder="" />
                <p class="label"></p>
            </fieldset>
            <button class="btn btn-primary w-full" type="submit">Sign In</button>
        </form>

        {{#error}}
        <p style="color: red;">{{error}}</p>
        {{/error}}
    </div>
</body>

</html>